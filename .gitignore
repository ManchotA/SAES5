# Fichiers ignorés par git pour toute l'équipe.
# Ajoutez vos lignes dans la section « Ajouts de l'équipe » tout en bas.
# Pour ignorer un fichier seulement chez vous, utilisez plutôt .git/info/exclude :
# c'est un gitignore personnel, propre à votre PC et jamais commité.
# Les règles propres à Angular (cache, build, tests) sont dans front/.gitignore.

# Node : dépendances, builds et journaux
node_modules/
dist/
npm-debug.log
yarn-error.log

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Base SQLite, créée par le back au démarrage
back/data/*.db

# Configuration locale (ports, chemins, mots de passe…)
.env

# Éditeurs
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.history/

# Visual Studio Code : seuls les réglages partagés sont versionnés
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json

# Systèmes
.DS_Store
Thumbs.db
desktop.ini

# ----- Ajouts de l'équipe -----
